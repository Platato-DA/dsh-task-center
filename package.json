{
  "name": "@dsh-external/dsh-task-center",
  "version": "0.1.0-beta.2",
  "description": "Schedule real Agent runs in DeepSeek Harness with per-task models, workspaces, run history and artifacts.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "BSD-3-Clause",
  "author": "pallwalt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Platato-DA/dsh-task-center.git"
  },
  "homepage": "https://github.com/Platato-DA/dsh-task-center#readme",
  "bugs": { "url": "https://github.com/Platato-DA/dsh-task-center/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "scheduler", "automation", "agent"],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs --client-only",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "gate": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "verify:timeout": "node scripts/verify-timeout.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.8",
    "react": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
